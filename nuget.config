<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for chuvadi-pdf (D-147).
  - nuget.org: test and tooling packages (see Directory.Packages.props).
  - .fonts-feed: Chuvadi.Fonts and Chuvadi.Fonts.Liberation, fetched by
    build/fetch-fonts.ps1 from the Chuvadi monorepo's fonts-v1.1.0 and
    fonts-liberation-v1.0.0 releases and checked against their SHA-256.
  Package source mapping keeps both on the local feed only, so a package of
  the same name elsewhere is never restored.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="chuvadi-fonts" value=".fonts-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="chuvadi-fonts">
      <package pattern="Chuvadi.Fonts" />
      <package pattern="Chuvadi.Fonts.Liberation" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
