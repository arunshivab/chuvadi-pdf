<Project>

  <PropertyGroup>
    <!-- Target framework -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Language version: always use latest C# -->
    <LangVersion>latest</LangVersion>

    <!-- Nullable reference types: mandatory, no exceptions -->
    <Nullable>enable</Nullable>

    <!-- No implicit usings: every dependency must be explicit -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Warnings are errors: no warning is ignorable in a foundational library -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Latest .NET analysis rules -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Allow unsafe code in projects that declare it explicitly -->
    <!-- Each project opts in via <AllowUnsafeBlocks>true</AllowUnsafeBlocks> -->

    <!-- Package metadata shared across all src projects -->
    <Authors>Chuvadi Contributors</Authors>
    <Company>Chuvadi</Company>
    <Product>Chuvadi PDF Library</Product>
    <Copyright>Copyright © 2025 Chuvadi Contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/arunshivab/chuvadi-pdf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/arunshivab/chuvadi-pdf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>pdf;document;parse;extract;merge;split;dotnet;csharp</PackageTags>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Deterministic builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Generate XML documentation for every project -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Suppress XML doc warnings for incomplete docs during active development.
         Remove this line before 1.0 release — every public member must be documented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Embed PDB into the DLL for easier debugging of the library by consumers -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Source Link: maps compiled code back to GitHub source -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- 3.31.2 (D-217 C): every shipped package under src/ declares itself
       trimming- and Native AOT-compatible, which turns on the trim, AOT and
       single-file analyzers; their warnings are errors like any other.
       Rendering.Wpf is left out (WPF does not support trimming), and so are
       tests, examples and tools. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Chuvadi.Pdf.Rendering.Wpf' and $([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/').StartsWith('src/'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- 3.31.2 (D-221): SDK package validation on every package under src/.
       Without a baseline it checks each package on its own. With a baseline,
       which build\pack.ps1 passes as ChuvadiBaselineDir and
       ChuvadiBaselineVersion (the folder holding the previous release's
       .nupkg files, normally local-nuget), pack fails on any public API that
       was removed or changed since that release. CI packs without a
       baseline, because the previous release is not on any feed it can reach. -->
  <PropertyGroup Condition="$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/').StartsWith('src/'))">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselinePath Condition="'$(ChuvadiBaselineDir)' != '' and '$(ChuvadiBaselineVersion)' != ''">$([System.IO.Path]::Combine('$(ChuvadiBaselineDir)', '$(MSBuildProjectName).$(ChuvadiBaselineVersion).nupkg'))</PackageValidationBaselinePath>
  </PropertyGroup>

  <!-- Version: controlled by build, not hardcoded here.
       Pass /p:Version=x.y.z on the dotnet pack command.
       Default to 0.1.0 during development. -->
  <PropertyGroup Condition="'$(Version)' == ''">
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-dev</InformationalVersion>
  </PropertyGroup>


  <!-- Include icon.png and README.md from repo root in every NuGet package -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
