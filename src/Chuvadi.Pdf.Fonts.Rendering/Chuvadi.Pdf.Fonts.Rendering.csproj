<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Chuvadi.Pdf.Fonts.Rendering</AssemblyName>
    <RootNamespace>Chuvadi.Pdf.Fonts.Rendering</RootNamespace>
    <Description>
      TrueType and OpenType glyph outline extraction for the Chuvadi
      PDF rasterizer. Reads font tables (head, hhea, maxp, loca, glyf,
      hmtx, cmap) from raw font bytes and converts glyph contours to
      Path objects from Chuvadi.Pdf.Graphics. Zero external dependencies.
    </Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\Standard14.bin" />
  </ItemGroup>
  <ItemGroup>
    <!-- D-106: the FreeType credit and its licence travel with the package
         that contains the FreeType-derived hinting code. -->
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\third-party\freetype\FTL.TXT" Pack="true" PackagePath="licenses\FreeType\FTL.TXT" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Chuvadi.Pdf.Fonts\Chuvadi.Pdf.Fonts.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Graphics\Chuvadi.Pdf.Graphics.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Objects\Chuvadi.Pdf.Objects.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Primitives\Chuvadi.Pdf.Primitives.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Chuvadi.Pdf.PdfA" />
    <InternalsVisibleTo Include="Chuvadi.Pdf.Authoring" />
    <InternalsVisibleTo Include="Chuvadi.Pdf.Rendering.Raster" />
    <InternalsVisibleTo Include="Chuvadi.Pdf.Rendering.DisplayList" />
  </ItemGroup>
</Project>
