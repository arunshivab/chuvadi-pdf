<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Chuvadi.Pdf.Rendering.DisplayList</AssemblyName>
    <RootNamespace>Chuvadi.Pdf.Rendering.DisplayList</RootNamespace>
    <PackageId>Chuvadi.Pdf.Rendering.DisplayList</PackageId>
    <Description>
      Immutable, renderer-neutral display list for PDF pages.
      A PageDisplayList is the output of interpreting a content stream and
      the input of every renderer in the Chuvadi stack (PageRasterizer,
      SvgRenderer, future PDF/UA accessibility walker). Coordinate space is
      PDF user space; CTM is baked into each op; clipping is recorded as
      per-op data. Zero raster, zero OS-coupled APIs — safe for WebAssembly.

      v2.0.0 Phase 2.1 additions: TextOp + DisplayListGlyph types and the
      TextRunExtractor walk-pass for grouped text retrieval (the shipping
      builder still emits per-glyph DrawGlyphOps; the new grouped-emit
      builder lands in v2.1).
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chuvadi.Pdf.Primitives\Chuvadi.Pdf.Primitives.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Objects\Chuvadi.Pdf.Objects.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Filters\Chuvadi.Pdf.Filters.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Graphics\Chuvadi.Pdf.Graphics.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Images\Chuvadi.Pdf.Images.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Fonts.Rendering\Chuvadi.Pdf.Fonts.Rendering.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Documents\Chuvadi.Pdf.Documents.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Text\Chuvadi.Pdf.Text.csproj" />
  </ItemGroup>

</Project>
