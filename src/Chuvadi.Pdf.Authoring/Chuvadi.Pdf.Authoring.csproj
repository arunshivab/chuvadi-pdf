<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>
      Chuvadi authoring module — fluent API to produce fresh PDF documents
      with text, tables, images, and primitives. Phase 1.3.
    </Description>
    <PackageId>Chuvadi.Pdf.Authoring</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Chuvadi.Pdf.Primitives\Chuvadi.Pdf.Primitives.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Objects\Chuvadi.Pdf.Objects.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.IO\Chuvadi.Pdf.IO.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Graphics\Chuvadi.Pdf.Graphics.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Images\Chuvadi.Pdf.Images.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Fonts.Rendering\Chuvadi.Pdf.Fonts.Rendering.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Text.Shaping\Chuvadi.Pdf.Text.Shaping.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Chuvadi.Fonts" />
    <!-- 3.33.0 (M1, D-307/D-308, D-311): the Liberation faces the standard-14
         embedding engine embeds. -->
    <PackageReference Include="Chuvadi.Fonts.Liberation" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Chuvadi.Pdf.PdfA" />
    <InternalsVisibleTo Include="Chuvadi.Pdf.Forms" />
    <InternalsVisibleTo Include="Chuvadi.Pdf.Signatures" />
    <InternalsVisibleTo Include="Chuvadi.Pdf.Authoring.Tests" />
    <InternalsVisibleTo Include="Chuvadi.Pdf.Operations" />
    <InternalsVisibleTo Include="Chuvadi.Pdf.PdfA.Tests" />
    <InternalsVisibleTo Include="Chuvadi.Pdf.Operations.Tests" />
  </ItemGroup>
</Project>
