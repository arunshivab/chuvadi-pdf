<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>
      Chuvadi authoring module — fluent API to produce fresh PDF documents
      with text, tables, images, and primitives. Phase 1.3.
    </Description>
    <PackageId>Chuvadi.Pdf.Authoring</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Chuvadi.Pdf.Primitives\Chuvadi.Pdf.Primitives.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Objects\Chuvadi.Pdf.Objects.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.IO\Chuvadi.Pdf.IO.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Graphics\Chuvadi.Pdf.Graphics.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Images\Chuvadi.Pdf.Images.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Documents\Chuvadi.Pdf.Documents.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Fonts.Rendering\Chuvadi.Pdf.Fonts.Rendering.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Fonts.Woff2\Chuvadi.Pdf.Fonts.Woff2.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Chuvadi.Pdf.PdfA" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\fonts\lipi-sans\fonts\LiPi-Sans-Latin.woff2">
      <LogicalName>Chuvadi.Pdf.Authoring.Lipi.LiPi-Sans-Latin.woff2</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\fonts\lipi-sans\fonts\LiPi-Sans-Tamil.woff2">
      <LogicalName>Chuvadi.Pdf.Authoring.Lipi.LiPi-Sans-Tamil.woff2</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\fonts\lipi-sans\fonts\LiPi-Sans-Devanagari.woff2">
      <LogicalName>Chuvadi.Pdf.Authoring.Lipi.LiPi-Sans-Devanagari.woff2</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\fonts\lipi-sans\fonts\LiPi-Sans-Bengali.woff2">
      <LogicalName>Chuvadi.Pdf.Authoring.Lipi.LiPi-Sans-Bengali.woff2</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\fonts\lipi-sans\fonts\LiPi-Sans-Gurmukhi.woff2">
      <LogicalName>Chuvadi.Pdf.Authoring.Lipi.LiPi-Sans-Gurmukhi.woff2</LogicalName>
