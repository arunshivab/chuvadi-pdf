      <LogicalName>Chuvadi.Pdf.Authoring.Lipi.LiPi-Sans-Odia.woff2</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\fonts\lipi-sans\fonts\LiPi-Sans-Telugu.woff2">
      <LogicalName>Chuvadi.Pdf.Authoring.Lipi.LiPi-Sans-Telugu.woff2</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\fonts\lipi-sans\fonts\LiPi-Sans-Kannada.woff2">
      <LogicalName>Chuvadi.Pdf.Authoring.Lipi.LiPi-Sans-Kannada.woff2</LogicalName>
