<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Chuvadi.Pdf.Svg</AssemblyName>
    <RootNamespace>Chuvadi.Pdf.Svg</RootNamespace>
    <PackageId>Chuvadi.Pdf.Svg</PackageId>
    <Description>
      SVG renderer for the Chuvadi PDF library.
      Consumes a PageDisplayList and emits deterministic, byte-for-byte
      reproducible SVG markup with native clipping support, glyph-outline
      reuse via &lt;defs&gt;/&lt;use&gt;, and optional Woff2 font embedding.
      Zero raster, zero OS-coupled APIs — safe for WebAssembly.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chuvadi.Pdf.Primitives\Chuvadi.Pdf.Primitives.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Objects\Chuvadi.Pdf.Objects.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Graphics\Chuvadi.Pdf.Graphics.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Images\Chuvadi.Pdf.Images.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Documents\Chuvadi.Pdf.Documents.csproj" />
    <ProjectReference Include="..\Chuvadi.Pdf.Rendering.DisplayList\Chuvadi.Pdf.Rendering.DisplayList.csproj" />
  </ItemGroup>

</Project>
